class Solution {
    public ArrayList<Integer> mergeThree(int[] a, int[] b, int[] c) {
        ArrayList<Integer> ans = new ArrayList<>();

        int i = 0, j = 0, k = 0;

        // Merge while all three arrays have elements
        while (i < a.length && j < b.length && k < c.length) {

            if (a[i] <= b[j] && a[i] <= c[k]) {
                ans.add(a[i++]);
            }
            else if (b[j] <= a[i] && b[j] <= c[k]) {
                ans.add(b[j++]);
            }
            else {
                ans.add(c[k++]);
            }
        }

        // Merge remaining a and b
        while (i < a.length && j < b.length) {
            if (a[i] <= b[j])
                ans.add(a[i++]);
            else
                ans.add(b[j++]);
        }

        // Merge remaining a and c
        while (i < a.length && k < c.length) {
            if (a[i] <= c[k])
                ans.add(a[i++]);
            else
                ans.add(c[k++]);
        }

        // Merge remaining b and c
        while (j < b.length && k < c.length) {
            if (b[j] <= c[k])
                ans.add(b[j++]);
            else
                ans.add(c[k++]);
        }

        // Remaining elements
        while (i < a.length)
            ans.add(a[i++]);

        while (j < b.length)
            ans.add(b[j++]);

        while (k < c.length)
            ans.add(c[k++]);

        return ans;
    }
}
