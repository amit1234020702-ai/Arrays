Best: O(n) — already sorted
Average: O(n²)
Worst: O(n²)
Space: O(1)
Stable: Yes

class Solution {
    // Please change the array in-place
    public void insertionSort(int arr[]) {
        // code here
        int n=arr.length;
        for(int i=1;i<n;i++){ 
            int key=arr[i];
            int j=i-1;
            while(j>=0 && arr[j] >key){ 
                arr[j+1]=arr[j];
                j--;
            }
            arr[j+1]=key;
        }
    }
}
