class Solution {
    public static void merge(int[] arr1, int[] arr2) {

        int n = arr1.length;
        int m = arr2.length;

        int gap = (n + m + 1) / 2;

        while (gap > 0) {

            int i = 0;
            int j = gap;

            while (j < n + m) {

                // Both elements are in arr1
                if (i < n && j < n) {

                    if (arr1[i] > arr1[j]) {
                        int temp = arr1[i];
                        arr1[i] = arr1[j];
                        arr1[j] = temp;
                    }
                }

                // One element in arr1, one in arr2
                else if (i < n && j >= n) {

                    if (arr1[i] > arr2[j - n]) {
                        int temp = arr1[i];
                        arr1[i] = arr2[j - n];
                        arr2[j - n] = temp;
                    }
                }

                // Both elements are in arr2
                else {

                    if (arr2[i - n] > arr2[j - n]) {
                        int temp = arr2[i - n];
                        arr2[i - n] = arr2[j - n];
                        arr2[j - n] = temp;
                    }
                }

                i++;
                j++;
            }

            if (gap == 1)
                gap = 0;
            else
                gap = (gap + 1) / 2;
        }
    }
}
s:o(n+m)
t:o(1)
