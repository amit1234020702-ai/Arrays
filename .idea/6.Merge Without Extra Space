Input: a[] = [2, 4, 7, 10], b[] = [2, 3]
Output: a[] = [2, 2, 3, 4], b[] = [7, 10]

import java.util.Arrays;

class Solution {
    public void mergeArrays(int a[], int b[]) {

        int i = 0;
        int j = 0;
        int k = a.length - 1;

        while (i <= k && j < b.length) {

            if (a[i] <= b[j]) {
                i++;
            } else {
                int temp = a[k];
                a[k] = b[j];
                b[j] = temp;

                k--;
                j++;
            }
        }

        Arrays.sort(a);
        Arrays.sort(b);
    }
}
