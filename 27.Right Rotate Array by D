class Solution {

    public static void reverse(int arr[], int start, int end) {
        while (start < end) {
            int temp = arr[start];
            arr[start] = arr[end];
            arr[end] = temp;

            start++;
            end--;
        }
    }

    public void rotateArr(int arr[], int d) {

        int n = arr.length;

        d = d % n;

        // 1. Reverse complete array
        reverse(arr, 0, n - 1);

        // 2. Reverse first d elements
        reverse(arr, 0, d - 1);

        // 3. Reverse remaining elements
        reverse(arr, d, n - 1);
    }
}
