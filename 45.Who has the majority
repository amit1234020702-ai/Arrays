Input: arr[] = [1, 1, 2, 2, 3, 3, 4, 4, 4, 4, 5], x = 4, y = 5
Output: 4

Input: arr[] = [1, 2, 3, 4, 5, 6, 7, 8], x = 1, y = 7
Output: 1




class Solution {
    public int moreFrequent(List<Integer> arr, int x, int y) {
        // code here
        int countX=0;
        int countY=0;
        for(int num:arr){ 
            if(num==x){ 
                countX++;
            }
            if(num==y){ 
                countY++;
            }
        }
        if(countX >countY){ 
            return x;
        }else if(countY>countX){ 
            return y;
        }
        
        else{ 
            return Math.min(x,y);
        }
        
    }
}
