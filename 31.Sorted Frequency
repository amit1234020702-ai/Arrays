//second
Time: O(n)
Space: O(1)

public class Main {
    public static void main(String[] args) {

        int[] arr = {1, 1, 2, 2, 2, 3, 4, 4};

        int n = arr.length;
        int i = 0;

        while (i < n) {

            int count = 1;

            while (i + 1 < n && arr[i] == arr[i + 1]) {
                count++;
                i++;
            }

            System.out.println(arr[i] + " -> " + count);

            i++;
        }
    }
}
