tow pointer
Time: O(n)
Space: O(1)
public class Main {
    public static void main(String[] args) {

        int[] arr = {1, 1, 2, 2, 2, 3, 4, 4};

        int i = 0;

        while (i < arr.length) {

            int j = i;

            while (j < arr.length && arr[i] == arr[j]) {
                j++;
            }

            System.out.println(arr[i] + " -> " + (j - i));

            i = j;
        }
    }
}
