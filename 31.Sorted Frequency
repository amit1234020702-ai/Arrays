//Input: arr[] = [3, 3, 2, 2, 1, 4]
Output:
1 1
2 2
3 2
4 1
T: O(n log n) 
S: O(1)

class Solution {
    public static void freqSorted(int arr[]) {
        Arrays.sort(arr);
        int n=arr.length;
        for(int i=0;i<n;i++){
            int count=1;
            while(i+1<n && arr[i]==arr[i+1]){
                count++;
                i++;
            
        }
        
        System.out.println(arr[i] +" "+count);
        }
        
    }
}
