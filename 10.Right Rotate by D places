Input: arr[] = [1, 2, 3, 4, 5], d = 2
Output: [3, 4, 5, 1, 2]
s:o(n)
T:o(1)

class Solution {
    public static void reverse(int arr[],int start,int end){
        while(start<end){
            int temp=arr[start];
            arr[start]=arr[end];
            arr[end]=temp;
            start++;
            end--;
        }
    }
    public void rotateArr(int arr[], int d) {
        int n=arr.length;
        d=d%n;
         reverse(arr, 0, d - 1);
          reverse(arr, d, n - 1);
           reverse(arr, 0, n - 1);
        
        
    }
}
