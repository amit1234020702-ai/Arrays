class Solution {
    public ArrayList<Integer> frequencyCount(int[] arr) {

        int n = arr.length;

        int hash[] = new int[n + 1];

        for (int num : arr) {
            hash[num]++;
        }

        ArrayList<Integer> ans = new ArrayList<>();

        for (int i = 1; i <= n; i++) {
            ans.add(hash[i]);
        }

        return ans;
    }
}
