Input:  [1, 2, 3, 4, 5, 6]
Output: [6, 1, 5, 2, 4, 3]
odd index=min
even index=max
///////////////////
class Solution {
    public void rearrange(long arr[], int n) {

        long max = arr[n - 1] + 1;
        int minIndex = 0;
        int maxIndex = n - 1;

        for (int i = 0; i < n; i++) {

            if (i % 2 == 0) {
                // Store maximum value
                arr[i] = arr[i] + (arr[maxIndex] % max) * max;
                maxIndex--;
            } 
            else {
                // Store minimum value
                arr[i] = arr[i] + (arr[minIndex] % max) * max;
                minIndex++;
            }
        }

        // Decode the values
        for (int i = 0; i < n; i++) {
            arr[i] = arr[i] / max;
        }
    }
}
