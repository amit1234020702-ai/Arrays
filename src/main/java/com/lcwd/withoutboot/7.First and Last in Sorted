Input: arr[] = [1, 3, 5, 5, 5, 5, 67, 123, 125], x = 5
Output: [2, 5]
Input: arr[] = [1, 3, 5, 5, 5, 5, 7, 123, 125], x = 7
Output: [6, 6]
Input: arr[] = [1, 2, 3], x = 4
Output: [-1, -1]

Time Complexity: O(log n)
Space Complexity: O(1)


class Solution {
    ArrayList<Integer> find(int arr[], int x) {
        ArrayList<Integer> ans=new ArrayList<>();
        int first=-1;
        int last=-1;
        //first occurance
        int low=0;
        int high=arr.length-1;
        while(low<=high){
            int mid=(low+high)/2;
            if(arr[mid]==x){
                first=mid;
                high=mid-1;
            
            }
            else if(arr[mid]<x){
                low=mid+1;
            }
            else{
                high=mid-1;
            }
        }
        low=0;
        high=arr.length-1;
          while(low<=high){
            int mid=(low+high)/2;
            if(arr[mid]==x){
                last=mid;
                low=mid+1;
            
            }
            else if(arr[mid]<x){
                low=mid+1;
            }
            else{
                high=mid-1;
            }
        }
        ans.add(first);
        ans.add(last);
        return ans;
        
    }
}
