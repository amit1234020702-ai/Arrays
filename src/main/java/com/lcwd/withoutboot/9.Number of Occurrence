Input: arr[] = [1, 1, 2, 2, 2, 2, 3], target = 2
Output: 4

Input: arr[] = [1, 1, 2, 2, 2, 2, 3], target = 4
Output: 0

Input: arr[] = [8, 9, 10, 12, 12, 12], target = 12
Output: 3

Time Complexity: O(log n)
Space Complexity: O(1)

class Solution {
    int countFreq(int[] arr, int target) {
        int first=-1;
        int last=-1;
        int low=0;
        int high=arr.length-1;
        while(low<=high){
            int mid=(low+high)/2;
            if(arr[mid]==target){
                first=mid;
                high=mid-1;
            }
            else if(arr[mid]<target){
                low=mid+1;
            }
                else {
                   high=mid-1; 
                }
            }
            if(first==-1){
                return 0;
            }
            
       
         low=0;
         high=arr.length-1;
        while(low<=high){
            int mid=(low+high)/2;
            if(arr[mid]==target){
                last=mid;
                low=mid+1;
            }
            else if(arr[mid]<target){
                low=mid+1;
            }
                else {
                   high=mid-1; 
                }
            }
    
        
        return last-first+1;
        
    }
}
