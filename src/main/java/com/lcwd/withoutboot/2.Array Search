Input: arr[] = [1, 2, 3, 4], x = 3
Output: 2
Input: arr[] = [10, 8, 30, 4, 5], x = 5
Output: 4
Input: arr[] = [10, 8, 30], x = 6
Output: -1

class Solution {
    public int search(int arr[], int x) {
        for(int i=0;i<=arr.length-1;i++){
            if(x==arr[i]){
                return i;
            }
        }
        return -1;
        
    }
}
