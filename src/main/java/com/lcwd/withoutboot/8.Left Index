
Input: arr[] = [1, 1, 2, 2, 3, 4, 5, 5, 6, 7], x = 1
Output: 0


class Solution {
    public int leftIndex(int[] arr, int x) {
        // code here
        int low=0,high=arr.length-1;
        int result=-1;
        while(low<=high){ 
            int mid=low+(high-low)/2;
            if(arr[mid]==x){ 
                result=mid;
                high=mid-1;
                
            }
            else if(arr[mid]<x){ 
                low=mid+1;
            }
            else{ 
                high=mid-1;
            }
        }
        return result;
    }
}
