arr = [5,6,7,8,9,10,1,2,3], key = 3
Time: O(log n)
Space: O(1)

class Solution {
    int search(int[] arr, int key) {
        int low = 0;
        int high = arr.length - 1;

        while (low <= high) {
            int mid = low + (high - low) / 2;

            // Target found
            if (arr[mid] == key) {
                return mid;
            }

            // Left half is sorted
            if (arr[low] <= arr[mid]) {

                // Key lies in left sorted half
                if (arr[low] <= key && key < arr[mid]) {
                    high = mid - 1;
                } 
                // Key lies in right half
                else {
                    low = mid + 1;
                }

            }
            // Right half is sorted
            else {

                // Key lies in right sorted half
                if (arr[mid] < key && key <= arr[high]) {
                    low = mid + 1;
                } 
                // Key lies in left half
                else {
                    high = mid - 1;
                }
            }
        }

        return -1;
    }
}
