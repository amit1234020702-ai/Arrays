Input: arr[] = [1, 2, 3, 4, 6], k = 6
Output: true
Input: arr[] = [1, 2, 4, 5, 6], k = 3
Output: false
Input: arr[] = [2, 3, 5, 6], k = 1
Output: false

class Solution {
    public boolean binarySearch(int[] arr, int k) {
       int start=0;
       int end=arr.length-1;
       while(start<=end){
           int mid=start+(end-start)/2;
           if(arr[mid]==k){
               return true;
           }
           else if(arr[mid]<k){
               start=mid+1;
           }
           else{
               end=mid-1;
           }
       }
       return false;
        
    }
}
