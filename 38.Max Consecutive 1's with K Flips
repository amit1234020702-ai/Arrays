Input: arr[] = [1, 0, 1], k = 1
Output: 3

Input: arr[] = [1, 0, 0, 1, 0, 1, 0, 1], k = 2
Output: 5



class Solution {
    public int maxOnes(int arr[], int k) {
        int left=0;
        int zeroCount=0;
        int maxLen=0;
        for(int right=0;right<arr.length;right++){
            if(arr[right]==0){
                zeroCount++;
            }
            while(zeroCount>k){
                if(arr[left]==0){
                    zeroCount--;
                }
                left++;
            }
            maxLen=Math.max(maxLen,right-left+1);
        }
        return maxLen;
        
    }
}
