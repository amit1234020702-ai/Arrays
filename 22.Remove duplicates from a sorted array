import java.util.*;

class Solution {
    int removeDuplicates(int[] arr) {

        Set<Integer> set = new LinkedHashSet<>();

        for (int num : arr) {
            set.add(num);
        }

        int i = 0;

        for (int num : set) {
            arr[i] = num;
            i++;
        }

        return i;
    }
}
