Input: arr[] = [10, 12, 14, 7, 8]
Output: 3

Input: arr[] = [4, 6]
Output: 1
class Solution {
    public static int maxEvenOdd(int[] arr) {
        int n=arr.length;
        int res=1;
      int curr=1;
        for(int i=1;i<n;i++){
            if((arr[i]%2==0 && arr[i-1]%2 !=0) || 
            (arr[i]%2 !=0 && arr[i-1]%2==0)){
                curr++;
                res=Math.max(res,curr);
            }else{
                curr=1;
            }
        }
        return res;
    }
}
