Input: arr[] = [2, 3, 4, -1, -2, 1, 5, 6, 3]
Output: 4
Input: arr[] = [1, 0, 0, 1, -1, -1, 0, 0, 1, 0]
Output: 4

class Solution {
    public int longestSubarray(int arr[]) {
   int curr=0;
   int maxLen=0;
   for(int i=0;i<arr.length;i++){
       if(arr[i]>=0){
           curr++;
           maxLen=Math.max(maxLen,curr);
       }else{
           curr=0;
       }
   }
   return maxLen;
    }
}
