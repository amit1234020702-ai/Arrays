arr = [2, 3, 10, 6, 4, 8, 1]
Maximum difference = 10 - 2 = 8
T:O(n)
i = 0 → arr[i] = 2
j = 2 → arr[j] = 10
j > i 
Difference = 10 - 2 = 8
dry run

/////////////////////
class Solution {
    int maxDifference(int arr[]) {
        int min = arr[0];
        int maxDiff = arr[1] - arr[0];

        for (int i = 1; i < arr.length; i++) {
            maxDiff = Math.max(maxDiff, arr[i] - min);
            min = Math.min(min, arr[i]);
        }

        return maxDiff;
    }
}
